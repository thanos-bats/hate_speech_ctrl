{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HateSpeechAPIOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Conversation identifier"
    },
    "app_id": {
      "type": "string",
      "description": "Application identifier"
    },
    "user_id": {
      "type": "string",
      "description": "User identifier"
    },
    "class": {
      "type": ["string", "null"],
      "enum": ["hate-speech", "no-hate-speech", null],
      "description": "Predicted class label for the whole conversation (Dev Cycle 2 — reporting model)"
    },
    "confidence_score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Model confidence for the whole conversation (Dev Cycle 2 — reporting model)"
    },
    "images": {
      "type": ["object", "null"],
      "description": "Per-image prediction results keyed by image id (Dev Cycle 1 — required when present)",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "enum": ["hate-speech", "no-hate-speech"],
            "description": "Predicted class label"
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Model confidence for the predicted class"
          }
        },
        "required": ["class", "confidence_score"]
      }
    }
  },
  "required": ["id", "app_id", "user_id"]
}
